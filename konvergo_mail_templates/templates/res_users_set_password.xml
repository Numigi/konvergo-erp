<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="set_password_template" model="mail.template">
    <field name="name">Auth Signup: Konvergo Connection</field>
    <field name="is_konvergo_template" eval="True"/>
    <field name="odoo_template_ref">auth_signup.set_password_email</field>
    <field name="email_from">"${object.company_id.name | safe}" &lt;${(object.company_id.email or user.email)|safe}&gt;</field>
    <field name="email_to">${object.email_formatted | safe}</field>
    <field name="lang">${object.partner_id.lang}</field>
    <field name="auto_delete" eval="True"/>
    <field name="subject_en">${object.create_uid.name} from ${object.company_id.name} invites you to connect to Konvergo</field>
    <field name="subject_fr">${object.create_uid.name} de ${object.company_id.name} vous invite à vous connecter à Konvergo</field>
    <field name="body_html_en" type="html">
      <table border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;">
        <tbody>
          <tr>
            <td align="center">
              <table border="0" cellpadding="0" cellspacing="0" width="590" style="padding: 16px; background-color: white; color: #454748; border-collapse:separate;">
                <tbody>
                  <!-- HEADER -->
                  <tr>
                    <td align="center" style="min-width: 590px;">
                      <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                        <tbody>
                          <tr>
                            <td valign="middle">
                              <span style="font-size: 10px;">Welcome to Konvergo</span>
                              <br/>
                              <span style="font-size: 20px; font-weight: bold;">
                                ${object.name}
                              </span>
                            </td>
                            <td valign="middle" align="right">
                              <img src="/logo.png?company=${object.company_id.id}" style="padding: 0px; margin: 0px; height: auto; width: 80px;" alt="${object.company_id.name}"/>
                            </td>
                          </tr>
                          <tr>
                            <td colspan="2" style="text-align:center;">
                              <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"/>
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </td>
                  </tr>
                  <!-- CONTENT -->
                  <tr style="line-height:2.5em;">
                    <td align="center" style="min-width: 590px;">
                      <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                        <tbody>
                          <tr>
                            <td valign="top" style="font-size: 13px;">
                              <div>
                                Dear ${object.name},<br/>
                                You have been invited by ${object.create_uid.name} of ${object.company_id.name} to connect on Konvergo.
                                <div style="margin: 16px 0px 16px 0px;">
                                  <a href="${object.signup_url}" style="background-color: #1a62c6; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                                    Accept invitation
                                  </a>
                                </div>
                                % set website_url = object.env['ir.config_parameter'].sudo().get_param('web.base.url')
                                Your Konvergo domain is:
                                <b>
                                  <a href="${website_url}">${website_url}</a>
                                </b>
                                <br/>
                                Your sign in email is:
                                <b>
                                  <a href="/web/login?login=${object.email}" target="_blank">${object.email}</a>
                                </b>
                                <br/>
                              </div>
                            </td>
                          </tr>
                          <tr>
                            <td style="text-align:center;">
                              <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"/>
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </td>
                  </tr>
                  <!-- FOOTER -->
                  <tr>
                    <td align="center" style="min-width: 590px;">
                      <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse:separate;">
                        <tbody>
                          <tr>
                            <td valign="middle" align="left">
                              ${object.company_id.name}
                            </td>
                          </tr>
                          <tr>
                            <td valign="middle" align="left" style="opacity: 0.7;">
                              ${object.company_id.phone}
                              % if object.company_id.email:
                              | <a href="'mailto:%s' % ${object.company_id.email}" style=" color: #454748;">${object.company_id.email}</a>
                              % endif
                              % if object.company_id.website:
                              | <a href="'%s' % ${object.company_id.website}" style=" color: #454748;">${object.company_id.website}</a>
                              % endif
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </td>
                  </tr>
                </tbody>
              </table>
            </td>
          </tr>
          <!-- POWERED BY -->
          <tr>
            <td align="center" style="min-width: 590px;">
              <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: #F1F1F1; color: #454748; padding: 8px; border-collapse:separate;">
                <tbody>
                  <tr>
                    <td style="text-align: center; font-size: 13px;">
                      Powered by <a target="_blank" href="https://www.konvergo.com?utm_source=db&amp;utm_medium=auth" style="color: #1a62c6;">Konvergo</a>
                    </td>
                  </tr>
                </tbody>
              </table>
            </td>
          </tr>
        </tbody>
      </table>
    </field>
    <field name="body_html_fr" type="html">
      <table border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;">
        <tbody>
          <tr>
            <td align="center">
              <table border="0" cellpadding="0" cellspacing="0" width="590" style="padding: 16px; background-color: white; color: #454748; border-collapse:separate;">
                <tbody>
                  <!-- HEADER -->
                  <tr>
                    <td align="center" style="min-width: 590px;">
                      <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                        <tbody>
                          <tr>
                            <td valign="middle">
                              <span style="font-size: 10px;">Bienvenue sur Konvergo</span>
                              <br/>
                              <span style="font-size: 20px; font-weight: bold;">
                                ${object.name}
                              </span>
                            </td>
                            <td valign="middle" align="right">
                              <img src="/logo.png?company=${object.company_id.id}" style="padding: 0px; margin: 0px; height: auto; width: 80px;" alt="${object.company_id.name}"/>
                            </td>
                          </tr>
                          <tr>
                            <td colspan="2" style="text-align:center;">
                              <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"/>
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </td>
                  </tr>
                  <!-- CONTENT -->
                  <tr style="line-height:2.5em;">
                    <td align="center" style="min-width: 590px;">
                      <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                        <tbody>
                          <tr>
                            <td valign="top" style="font-size: 13px;">
                              <div>
                                Cher(e) ${object.name},<br/>
                                Vous avez été invité par ${object.create_uid.name} de ${object.company_id.name} à rejoindre Konvergo.
                                <div style="margin: 16px 0px 16px 0px;">
                                  <a href="${object.signup_url}" style="background-color: #1a62c6; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                                    Accepter l'invitation
                                  </a>
                                </div>
                                % set website_url = object.env['ir.config_parameter'].sudo().get_param('web.base.url')
                                Votre nom de domaine Konvergo est:
                                <b>
                                  <a href="${website_url}">${website_url}</a>
                                </b>
                                <br/>
                                Votre courriel de connexion est:
                                <b>
                                  <a href="/web/login?login=${object.email}" target="_blank">${object.email}</a>
                                </b>
                                <br/>
                              </div>
                            </td>
                          </tr>
                          <tr>
                            <td style="text-align:center;">
                              <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"/>
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </td>
                  </tr>
                  <!-- FOOTER -->
                  <tr>
                    <td align="center" style="min-width: 590px;">
                      <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse:separate;">
                        <tbody>
                          <tr>
                            <td valign="middle" align="left">
                              ${object.company_id.name}
                            </td>
                          </tr>
                          <tr>
                            <td valign="middle" align="left" style="opacity: 0.7;">
                              ${object.company_id.phone}
                              % if object.company_id.email:
                              | <a href="'mailto:%s' % ${object.company_id.email}" style=" color: #454748;">${object.company_id.email}</a>
                              % endif
                              % if object.company_id.website:
                              | <a href="'%s' % ${object.company_id.website}" style=" color: #454748;">${object.company_id.website}</a>
                              % endif
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </td>
                  </tr>
                </tbody>
              </table>
            </td>
          </tr>
          <!-- POWERED BY -->
          <tr>
            <td align="center" style="min-width: 590px;">
              <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: #F1F1F1; color: #454748; padding: 8px; border-collapse:separate;">
                <tbody>
                  <tr>
                    <td style="text-align: center; font-size: 13px;">
                      Propulsé par <a target="_blank" href="https://www.konvergo.com?utm_source=db&amp;utm_medium=auth" style="color: #1a62c6;">Konvergo</a>
                    </td>
                  </tr>
                </tbody>
              </table>
            </td>
          </tr>
        </tbody>
      </table>
    </field>
  </record>

</odoo>
